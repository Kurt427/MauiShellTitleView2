<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiShellTitleView2.SubPage">

    <Shell.TitleView>
        <Grid RowDefinitions="*" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" Text="Sub Page" TextColor="White"/>
            <Label Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Text="Save" TextColor="White"/>
        </Grid>
    </Shell.TitleView>
    
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>